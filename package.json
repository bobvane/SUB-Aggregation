{
  "name": "sub-aggregation",
  "version": "2.36.7",
  "description": "SUB-Aggregation V2 - 订阅聚合与配置生成平台（NAS / Docker 部署）",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "npm run build:server && node dist/server.mjs",
    "start": "node dist/server.mjs",
    "build:html": "node scripts/inline-html.js",
    "build:server": "npm run build:html && esbuild src/server/main.ts --bundle --platform=node --format=esm --target=node24 --banner:js='import{createRequire}from\"node:module\";const require=createRequire(import.meta.url);' --outfile=dist/server.mjs",
    "build": "npm run build:html && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.8",
    "yaml": "^2"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "@vitest/coverage-v8": "^5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "prettier": "^3",
    "typescript": "^5",
    "vite": "^7.3.6",
    "vitest": "^5"
  },
  "overrides": {
    "js-yaml": "^4.3.2"
  },
  "engines": {
    "node": ">=22.21"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true
  }
}
